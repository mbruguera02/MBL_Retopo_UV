+void Optimizer::apply_scale_field(Hierarchy& mRes, const VectorXd& rho) {
+    MatrixXd& S0 = mRes.mS[0];
+    for (int i = 0; i < S0.cols(); ++i) {
+        S0(0, i) = rho[i];
+        S0(1, i) = rho[i];
+    }
+    for (int l = 0; l < (int)mRes.mS.size() - 1; ++l) {
+        const MatrixXd& S = mRes.mS[l];
+        MatrixXd& S_next = mRes.mS[l + 1];
+        auto& toUpper = mRes.mToUpper[l];
+        for (int i = 0; i < toUpper.cols(); ++i) {
+            Vector2i upper = toUpper.col(i);
+            Vector2d q0 = S.col(upper[0]);
+            if (upper[1] != -1)
+                q0 = (q0 + S.col(upper[1])) * 0.5;
+            S_next.col(i) = q0;
+        }
+    }
+}
