+#include <fstream>  /* MBL: archivo de densidad */
+
+/* MBL: densidad adaptativa por curvatura.
+   Devuelve el tamaño de arista objetivo de cada vértice de entrada: caras grandes en zonas planas y
+   pequeñas en zonas curvas. Se normaliza para que el número total de caras sea el mismo que con la
+   escala uniforme 'base_scale'. */
+static VectorXf mbl_adaptive_scale(const MatrixXf &V, const MatrixXf &N, const VectorXf &A,
+                                   const AdjacencyMatrix &adj, Float base_scale,
+                                   Float strength, Float ratio) {
+    const uint32_t n = (uint32_t) V.cols();
+    VectorXf k(n), tmp(n);
+
+    /* 1. curvatura aproximada: ángulo entre normales vecinas / distancia */
+    double len_sum = 0; size_t len_count = 0;
+    for (uint32_t i = 0; i < n; ++i) {
+        Float sum = 0; uint32_t count = 0;
+        for (Link *link = adj[i]; link != adj[i+1]; ++link) {
+            const uint32_t j = link->id;
+            const Float d = (V.col(i) - V.col(j)).norm();
+            if (d <= 0)
+                continue;
+            const Float c = std::max((Float) -1, std::min((Float) 1, N.col(i).dot(N.col(j))));
+            sum += std::acos(c) / d;
+            len_sum += d; ++len_count;
+            ++count;
+        }
+        k[i] = count ? sum / count : 0;
+    }
+    const Float avg_len = len_count ? (Float) (len_sum / len_count) : base_scale;
+
+    /* suavizado por difusión: el radio crece ~ longitud * sqrt(iteraciones) */
+    auto smooth = [&](VectorXf &f, int iterations) {
+        for (int it = 0; it < iterations; ++it) {
+            for (uint32_t i = 0; i < n; ++i) {
+                Float sum = 0; uint32_t count = 0;
+                for (Link *link = adj[i]; link != adj[i+1]; ++link) {
+                    sum += f[link->id]; ++count;
+                }
+                tmp[i] = count ? 0.5f * f[i] + 0.5f * sum / count : f[i];
+            }
+            f.swap(tmp);
+        }
+    };
+    const Float radius_ratio = base_scale / std::max(avg_len, (Float) 1e-12);
+    const int iterations = (int) std::max(4.0f, std::min(300.0f, radius_ratio * radius_ratio));
+    smooth(k, iterations);
+
+    auto median = [&](const VectorXf &f) -> Float {
+        std::vector<Float> values(f.data(), f.data() + f.size());
+        std::nth_element(values.begin(), values.begin() + values.size() / 2, values.end());
+        return values[values.size() / 2];
+    };
+
+    /* 2. tamaño ~ 1/sqrt(curvatura) (error de cuerda constante), mezclado con uniforme según 'strength' */
+    const Float k_ref = std::max(median(k), (Float) 1e-12);
+    VectorXf f(n);
+    for (uint32_t i = 0; i < n; ++i)
+        f[i] = std::pow((k[i] + k_ref) / (2 * k_ref), -0.5f * strength);
+
+    /* 3. limitar la relación entre caras grandes y pequeñas y volver a suavizar */
+    const Float f_med = median(f);
+    for (uint32_t i = 0; i < n; ++i)
+        f[i] = std::max(f_med / ratio, std::min(f_med * ratio, f[i]));
+    smooth(f, std::max(4, iterations / 2));
+
+    /* 4. normalizar: mismo número de caras que con la escala uniforme */
+    double area = 0, weighted = 0;
+    for (uint32_t i = 0; i < n; ++i) {
+        area += A[i];
+        weighted += A[i] / (double) (f[i] * f[i]);
+    }
+    const Float c = base_scale * (Float) std::sqrt(weighted / std::max(area, 1e-30));
+    VectorXf S = f * c;
+
+    cout << "Adaptive density (strength " << strength << ", ratio " << ratio << ", "
+         << iterations << " smoothing steps): edge length min " << S.minCoeff()
+         << ", median " << median(S) << ", max " << S.maxCoeff() << endl;
+    return S;
+}
+
+/* MBL: densidad pintada por el usuario.
+   'density_file' tiene un valor por vértice de entrada (en el orden del PLY): 1 = normal, m = m veces
+   más caras por unidad de área. El tamaño de arista va con 1/sqrt(m). Los vértices que añade la
+   subdivisión (al final) toman el valor de sus vecinos. Se normaliza para mantener el nº de caras. */
+static VectorXf mbl_density_scale(const MatrixXf &V, const VectorXf &A, const AdjacencyMatrix &adj,
+                                  Float base_scale, uint32_t input_vertices,
+                                  const std::string &density_file) {
+    const uint32_t n = (uint32_t) V.cols();
+    VectorXf f(n), tmp(n);
+    std::vector<char> known(n, 0);
+    std::ifstream is(density_file);
+    if (!is.good())
+        throw std::runtime_error("Could not open density file \"" + density_file + "\"");
+    uint32_t read = 0;
+    Float value;
+    while (read < input_vertices && read < n && (is >> value)) {
+        f[read] = 1.0f / std::sqrt(std::max(value, (Float) 1e-3));
+        known[read] = 1;
+        ++read;
+    }
+    if (read != input_vertices)
+        throw std::runtime_error("Density file has " + std::to_string(read) + " values, expected " +
+                                 std::to_string(input_vertices));
+
+    /* vértices nuevos: media de los vecinos conocidos, por capas hasta rellenarlos todos */
+    for (bool pending = true; pending; ) {
+        pending = false;
+        bool progress = false;
+        for (uint32_t i = 0; i < n; ++i) {
+            if (known[i])
+                continue;
+            Float sum = 0; uint32_t count = 0;
+            for (Link *link = adj[i]; link != adj[i+1]; ++link)
+                if (known[link->id] == 1) { sum += f[link->id]; ++count; }
+            if (count) { f[i] = sum / count; known[i] = 2; progress = true; } else pending = true;
+        }
+        for (uint32_t i = 0; i < n; ++i)
+            if (known[i] == 2) known[i] = 1;
+        if (!progress)
+            break;
+    }
+    for (uint32_t i = 0; i < n; ++i)
+        if (!known[i]) f[i] = 1;
+
+    /* suavizado ligero: la transición entre zonas no debe ser un escalón */
+    for (int it = 0; it < 8; ++it) {
+        for (uint32_t i = 0; i < n; ++i) {
+            Float sum = 0; uint32_t count = 0;
+            for (Link *link = adj[i]; link != adj[i+1]; ++link) { sum += f[link->id]; ++count; }
+            tmp[i] = count ? 0.5f * f[i] + 0.5f * sum / count : f[i];
+        }
+        f.swap(tmp);
+    }
+
+    /* normalizar: mismo número de caras que con la escala uniforme */
+    double area = 0, weighted = 0;
+    for (uint32_t i = 0; i < n; ++i) {
+        area += A[i];
+        weighted += A[i] / (double) (f[i] * f[i]);
+    }
+    const Float c = base_scale * (Float) std::sqrt(weighted / std::max(area, 1e-30));
+    VectorXf S = f * c;
+    cout << "Painted density: " << read << " values, edge length min " << S.minCoeff()
+         << ", max " << S.maxCoeff() << endl;
+    return S;
+}
+
+/* MBL: direcciones guía para el campo de orientación.
+   'orient_file' tiene una línea "dx dy dz peso" por vértice de entrada (orden del PLY). La dirección
+   se proyecta al plano tangente; el peso (0..1) es cuánto tira de la orientación en cada iteración.
+   Las calcula el plugin (curvatura principal, anillos de tubos, guías del usuario). Los vértices
+   que añade la subdivisión quedan libres y siguen a sus vecinos. Los bordes (-b) tienen prioridad. */
+static void mbl_read_orientation(MultiResolutionHierarchy &mRes, uint32_t input_vertices,
+                                 const std::string &orient_file) {
+    std::ifstream is(orient_file);
+    if (!is.good())
+        throw std::runtime_error("Could not open orientation file \"" + orient_file + "\"");
+    const MatrixXf &N = mRes.N();
+    uint32_t read = 0, used = 0;
+    Float dx, dy, dz, w;
+    while (read < input_vertices && (is >> dx >> dy >> dz >> w)) {
+        const uint32_t i = read++;
+        if (w <= 0 || mRes.CQw()[i] != 0)
+            continue;
+        Vector3f d(dx, dy, dz), n = N.col(i);
+        d -= n * n.dot(d);
+        if (d.squaredNorm() < 1e-12f)
+            continue;
+        mRes.CQ().col(i) = d.normalized();
+        mRes.CQw()[i] = std::min(w, (Float) 1);
+        ++used;
+    }
+    if (read != input_vertices)
+        throw std::runtime_error("Orientation file has " + std::to_string(read) + " rows, expected " +
+                                 std::to_string(input_vertices));
+    mRes.mSoftConstraints = true;
+    cout << "Orientation guides: " << used << " of " << read << " vertices" << endl;
+}
 
